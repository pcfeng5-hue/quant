  "findings": [
    {
      "id": "TIME01",
      "kind": "design_requirement",
      "finding": "区分信号归属日、特征真实首次可得时间、决策生成时间、委托/成交窗口和结果成熟时间。source_trade_date不等于available_at。",
      "application": "t_signal_date仅作归属；decision_at必须晚于全部必需输入可得时间，未认证时不宣称正式历史可用。"
    },
    {
      "id": "TIME02",
      "kind": "design_requirement",
      "finding": "旧5观察日按已保存行情行号取样；若停牌/数据缺失可能跳过计划交易日。它不等于5个计划交易日，更不等于5自然日。",
      "application": "建议正式动作比较用在t时可知的官方计划交易日历固定共同终点；不能用未来是否有成交来决定终点。期限H仍待确认。"
    },
    {
      "id": "TIME03",
      "kind": "source_supported_and_design_inference",
      "finding": "普通现金A股不能假设当日新买数量马上可卖；底仓做T需实际可卖量、持仓批次和在途订单。",
      "source_id": "SZSE_2026_RULE_PDF",
      "articles": [
        "3.1.1",
        "3.1.4",
        "3.1.5"
      ],
      "application": "做T另立问题，不由日线买入vs等待推导；不把T+1口号替代账户available_to_sell和停牌/冻结校验。"
    },
    {
      "id": "TIME04",
      "kind": "source_supported_and_design_inference",
      "finding": "开盘价是该证券首笔竞价成交价；价格/时间队列与对手方决定投资者成交，OHLC价不保证该订单可成交。",
      "source_id": "SZSE_2026_RULE_PDF",
      "articles": [
        "3.3.21",
        "3.4.2",
        "4.2.1"
      ],
      "application": "下一计划交易日开盘价可作为明示理想化参考，但不能标已成交；计划窗口不可成交需记录未成交、部分成交、过期等状态，保留现金。"
    },
    {
      "id": "TIME05",
      "kind": "material_rule_boundary",
      "finding": "2026-07-06生效规则允许A股盘后固定价格交易，15:05—15:30以当日收盘价时间优先撮合，不能写收盘后绝不可能以当日收盘价成交。",
      "source_id": "SZSE_2026_RULE_PDF",
      "articles": [
        "3.6.1",
        "3.6.2",
        "3.6.3",
        "3.6.8"
      ],
      "application": "本项目未核券商渠道、可得性、排队与成交，仍不得默认同收盘价成交；首版建议下一计划交易窗口，盘后模式另立协议且不回填2023/24。"
    },
    {
      "id": "TIME06",
      "kind": "material_information_cutoff",
      "finding": "盘后成交量/额在该阶段结束后才计入当日总量；含完整日量的特征不能默认为15:00已知，可能需要15:30后并加供应商延迟。",
      "source_id": "SZSE_2026_RULE_PDF",
      "articles": [
        "3.6.10"
      ],
      "application": "信息截止需逐字段定义；若15:05作决策只能用已认证的局部成交量版本，不能事后拿完整日量回填。"
    },
    {
      "id": "TIME07",
      "kind": "design_inference",
      "finding": "日OHLC未保存盘内高低先后；同一日同时触及止盈止损不能默认有利顺序。",
      "application": "记录路径顺序不明；允许保守/区间/排除敏感性，但处理须事先固定。持有首日开盘前的日内高低也不可计入真实持仓MAE。"
    },
    {
      "id": "TIME08",
      "kind": "source_supported_and_design_requirement",
      "finding": "除权除息参考价改变价格标尺，股数与现金权利可能变化；原价下降不等于同额财富损失。",
      "source_id": "SZSE_2026_RULE_PDF",
      "articles": [
        "4.4.1",
        "4.4.2",
        "4.4.3"
      ],
      "application": "先固定毛财富含现金/股份/应收权益及实际可用现金的区别；股息税、权利到账/锁定、配股选择与成本另列未知，不默认红利税0。"
    },
    {
      "id": "TIME09",
      "kind": "source_supported_and_design_requirement",
      "finding": "无成交时收盘价可沿用前收盘价；有价格字段不证明新成交、可买卖或可退出。",
      "source_id": "SZSE_2026_RULE_PDF",
      "articles": [
        "4.2.3",
        "4.3.3"
      ],
      "application": "共同终点如无法退出，分别报告市值估值和未平仓/价格陈旧状态，不能把估值当已实现现金。"
    },
    {
      "id": "TIME10",
      "kind": "scope_requirement",
      "finding": "用户已确认首版优先收盘后买入vs等待；这次确认不冻结H、最大等待、确认条件、费用、仓位或真实交易许可。",
      "application": "现有草案保持不改；新确认另存需求变更，所有未定阈值继续NULL，不因审查完成就开放真实标签或资金。"
    }
  ],
