  "candidate_definition_review": [
    {
      "candidate": "单源指数过去k日简单价格收益",
      "formula": "r_I,k(t) = C_I(t) / C_I(t-k) - 1",
      "engineering_assessment": "可准备",
      "guards": [
        "k和观测日轴事前登记，不优化",
        "固定source/symbol/raw price index口径",
        "只用<=t的完整收盘观测，分母正且有限",
        "不前填缺值，不压缩缺失日当连续日",
        "标记实际端点日期，不称日历k天或官方已认证交易k日",
        "不当作总收益或可交易组合收益"
      ]
    },
    {
      "candidate": "收盘相对MA20",
      "formula": "MA20_I(t) = mean(C_I(t-19),...,C_I(t)); distance_I,20(t) = C_I(t)/MA20_I(t)-1",
      "engineering_assessment": "可准备，但必须固定尺度及是否含当日",
      "guards": [
        "本定义含t共20个同源正有限收盘价",
        "若改用严格过去20日或点差，属于另一个定义，应另行登记",
        "冷启动/缺失返回null，不能以短窗冒充20日",
        "同日完整收盘之后可算；无趋势方向或概率结论"
      ]
    },
    {
      "candidate": "个股相对指数过去5日价格收益差",
      "formula": "relative_price_return_5(t) = [C_S(t)/C_S(t-5)-1] - [C_I(t)/C_I(t-5)-1]",
      "engineering_assessment": "可准备；只称价格收益差，不称可实现超额收益",
      "guards": [
        "先冻结共同日期轴，个股及指数t与t-5的真实日期必须相同",
        "股票端点及全部支撑日期处于同一已定义原价连续分段，跨未知2022断点/已知除权日则弃答",
        "共6个观察日完整，不因任一系列缺值压缩日期",
        "指数全窗单源同口径，股票用已登记原价，不混入当前前复权",
        "收益差为百分点尺度，不是两个百分数相除的比率",
        "成员未知时仅称相对军工背景代理；不能称行业中性或去除行业贡献",
        "若未来证实股票为成分，需披露指数可能含股票自身贡献；本差值也不证明独立因果信息"
      ]
    }
  ],
